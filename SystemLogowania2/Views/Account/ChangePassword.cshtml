@model ChangePasswordVm
@inject SystemLogowania2.Services.TurnstileService Turnstile
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
@{ ViewData["Title"] = "Zmiana hasła"; }
<div class="card narrow">
  <h1>Zmiana hasła</h1>
  @if (Model.Forced)
  {
    <p class="muted">Musisz ustawić nowe hasło, zanim przejdziesz dalej
       (hasło jednorazowe, pierwsze logowanie lub hasło wygasło).</p>
  }
  <p class="muted">Wymagania: minimum @Passwords.MinLength znaków@(Model.Rule ? ", fraza hasłowa co najmniej 3 słowa oddzielone spacją lub myślnikiem" : "").
     Nowe hasło musi różnić się od poprzednich.</p>
  <div asp-validation-summary="ModelOnly" class="flash error"></div>
  <form asp-action="ChangePassword" method="post">
    <label asp-for="OldPassword">@(Model.Forced ? "Hasło obecne / jednorazowe" : "Stare hasło")</label>
    <input asp-for="OldPassword" type="password" autocomplete="current-password" required />
    <label asp-for="NewPassword">Nowe hasło</label>
    <input asp-for="NewPassword" type="password" autocomplete="new-password" required />
    <label asp-for="NewPassword2">Powtórz nowe hasło</label>
    <input asp-for="NewPassword2" type="password" autocomplete="new-password" required />
        <div class="cf-turnstile" data-sitekey="@Turnstile.SiteKey" style="margin-top:12px"></div>
    <button type="submit">Zmień hasło</button>
  </form>
</div>
