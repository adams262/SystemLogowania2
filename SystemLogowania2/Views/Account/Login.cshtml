@model LoginVm
@inject SystemLogowania2.Services.TurnstileService Turnstile
@{
    ViewData["Title"] = "Logowanie";
}
<script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
<div class="card narrow">
    <h1>Logowanie</h1>
    <div asp-validation-summary="ModelOnly" class="flash error"></div>
    <form asp-action="Login" method="post">
        <label asp-for="Username">Login</label>
        <input asp-for="Username" autocomplete="username" autofocus required />
        <label asp-for="Password">Hasło</label>
        <input asp-for="Password" type="password" autocomplete="current-password" required />

        @* pułapka na boty: ukryte pole, człowiek go nie widzi *@
        <div style="position:absolute;left:-9999px" aria-hidden="true">
            <label for="website">Nie wypełniaj tego pola</label>
            <input asp-for="Website" id="website" tabindex="-1" autocomplete="off" />
        </div>

        <div class="cf-turnstile" data-sitekey="@Turnstile.SiteKey" style="margin-top:12px"></div>
        <button type="submit">Zaloguj</button>
    </form>
</div>