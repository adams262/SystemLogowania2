@using System.Security.Claims
@{
    var authed = User.Identity?.IsAuthenticated == true;
    var role = User.FindFirstValue(ClaimTypes.Role);
}
<!doctype html>
<html lang="pl">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>@ViewData["Title"] – Moduł 1</title>
  <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
<header>
  <span class="brand">Moduł 1 · Uwierzytelnianie</span>
  @if (authed)
  {
    <a asp-controller="Home" asp-action="Index">Start</a>
    @if (Permissions.Has(role, Permissions.UsersManage))
    {
      <a asp-controller="Admin" asp-action="Users">Użytkownicy</a>
    }
    @if (Permissions.Has(role, Permissions.SettingsManage))
    {
      <a asp-controller="Admin" asp-action="Settings">Ustawienia</a>
    }
    <a asp-controller="Account" asp-action="ChangePassword">Zmiana hasła</a>
    <span class="muted">@User.Identity!.Name (@role)</span>
    <form asp-controller="Account" asp-action="Logout" method="post">
      <button class="secondary" type="submit">Wyloguj</button>
    </form>
  }
</header>
<main>
  @if (TempData["ok"] is string okMsg)
  {
    <div class="flash ok">@okMsg</div>
  }
  @if (TempData["error"] is string errMsg)
  {
    <div class="flash error">@errMsg</div>
  }
  @RenderBody()
</main>
</body>
</html>
